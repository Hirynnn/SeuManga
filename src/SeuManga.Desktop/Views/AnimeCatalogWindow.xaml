<Window x:Class="SeuManga.Desktop.Views.AnimeCatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Explorar animes · SeuManga" Width="1250" Height="800" MinWidth="900" MinHeight="600" Background="#0D0B12" Foreground="#F5F3FF" WindowStartupLocation="CenterOwner">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#8B5CF6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#211B2B"/><Setter Property="Foreground" Value="#F5F3FF"/><Setter Property="BorderBrush" Value="#332A40"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="White"/></Style></Window.Resources>
<DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="CATÁLOGO JIKAN · MYANIMELIST" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/><TextBlock Text="Explorar animes" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,16"/><DockPanel><Button DockPanel.Dock="Right" Content="Pesquisar" Command="{Binding SearchCommand}" Margin="10,0,0,0"/><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Text="{Binding Message}" Foreground="#A1A1AA" Margin="0,10,0,12"/><Button Content="Carregar mais episódios" Command="{Binding LoadMoreEpisodesCommand}" Background="#211B2B" HorizontalAlignment="Left" Margin="0,0,0,10"/></StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><DockPanel Grid.Column="0" Margin="0,0,20,0"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10"><Button Content="‹ Anterior" Command="{Binding PreviousCommand}" Background="#211B2B"/><Button Content="Próxima ›" Command="{Binding NextCommand}" Background="#211B2B" Margin="8,0,0,0"/></StackPanel>
<ListBox x:Name="AnimeList" ItemsSource="{Binding Results}" SelectionChanged="AnimeList_SelectionChanged" Background="#17131F" BorderBrush="#332A40" Foreground="#F5F3FF"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" BorderBrush="#332A40" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding ImageUrl}" Width="52" Height="70" Stretch="UniformToFill"/><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding TitleEnglish}" Foreground="#A1A1AA" FontSize="11"/><TextBlock Text="{Binding Year}" Foreground="#A78BFA" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Details}"><TextBlock Text="{Binding Anime.Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Anime.TitleEnglish}" Foreground="#A78BFA" Margin="0,4,0,0"/><TextBlock Text="{Binding Anime.Synopsis}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="21"/><TextBlock Text="{Binding Anime.Status}" Margin="0,10,0,0"/><TextBlock Text="{Binding Anime.Score, StringFormat=Avaliação: {0}}" Foreground="#A78BFA" Margin="0,5,0,0"/><TextBlock Text="{Binding Genres, StringFormat=Gêneros: {0}}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding Studios, StringFormat=Estúdios: {0}}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,5,0,0"/><DockPanel Margin="0,18,0,6"><TextBlock DockPanel.Dock="Right" Text="{Binding DataContext.ProgressLabel, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#A78BFA" VerticalAlignment="Center"/><Button Content="Adicionar anime à biblioteca" Click="AddAnime_Click" Background="#6D28D9"/><TextBlock Text="Episódios consultados" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding DataContext.Episodes, RelativeSource={RelativeSource AncestorType=Window}}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#17131F" BorderBrush="#332A40" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,7"><StackPanel><TextBlock Text="{Binding Number, StringFormat=Episódio {0}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,0"/><DockPanel Margin="0,4,0,0"><TextBlock Text="{Binding Aired}" Foreground="#71717A" FontSize="11" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Alternar visto" Tag="{Binding}" Click="EpisodeWatched_Click" Background="#211B2B" Padding="8,5"/></DockPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="TMDB · temporadas e episódios" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,7"/><TextBlock Text="{Binding DataContext.Tmdb.Name, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#A78BFA" FontWeight="SemiBold"/><TextBlock Text="{Binding DataContext.Tmdb.Overview, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,4,0,8"/><ItemsControl ItemsSource="{Binding DataContext.TmdbSeasons, RelativeSource={RelativeSource AncestorType=Window}}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#17131F" BorderBrush="#332A40" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Carregar episódios" Tag="{Binding}" Click="LoadTmdbSeason_Click" Background="#211B2B" Padding="8,5"/></DockPanel><TextBlock Text="{Binding EpisodeCount, StringFormat=Episódios informados: {0}}" Foreground="#A1A1AA" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Message}" Foreground="#A78BFA" TextWrapping="Wrap" Margin="0,4,0,0"/><ItemsControl ItemsSource="{Binding Episodes}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#332A40" BorderThickness="0,1,0,0" Padding="8" Margin="0,5,0,0"><StackPanel><TextBlock Text="{Binding EpisodeNumber, StringFormat=Episódio {0}: }" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Foreground="#F5F3FF"/><TextBlock Text="{Binding Overview}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding AirDate}" Foreground="#71717A" FontSize="11"/><TextBlock Text="{Binding Runtime, StringFormat=Duração: {0} min}" Foreground="#71717A" FontSize="11"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Onde assistir" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,7"/><TextBlock Text="{Binding DataContext.Availability.Message, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding DataContext.Availability.Sources, RelativeSource={RelativeSource AncestorType=Window}}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Url}" Click="Streaming_Click" HorizontalAlignment="Left" Background="#211B2B" Margin="0,0,0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding DataContext.Tmdb.Attribution, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#71717A" TextWrapping="Wrap" Margin="0,3,0,10"/><TextBlock Text="Recomendações Jikan" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,7"/><ItemsControl ItemsSource="{Binding DataContext.Recommendations, RelativeSource={RelativeSource AncestorType=Window}}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Anime.Title}" Tag="{Binding Anime}" Click="Recommendation_Click" HorizontalAlignment="Left" Background="#211B2B" Margin="0,0,0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid></DockPanel></Window>





