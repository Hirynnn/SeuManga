<Window x:Class="SeuManga.Desktop.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configurações · SeuManga" Width="860" Height="720" MinWidth="680" MinHeight="540" Background="#0D0B12" Foreground="#F5F3FF" WindowStartupLocation="CenterOwner">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34"><TextBlock Text="CONFIGURAÇÕES" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/><TextBlock Text="Provedores e privacidade" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,22"/><TextBlock Text="As chaves são criptografadas com DPAPI para sua conta Windows e nunca ficam no código ou em texto simples." Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,20"/>
<Border Background="#17131F" BorderBrush="#332A40" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="TMDB" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Complementa informações de séries, temporadas, banners e disponibilidade regional. O uso requer atribuição ao TMDB e JustWatch." Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,8,0,12"/><PasswordBox x:Name="TmdbKey" Background="#211B2B" Foreground="#F5F3FF" BorderBrush="#332A40" Padding="10"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Salvar chave" Click="SaveTmdb_Click"/><Button Content="Testar conexão" Click="TestTmdb_Click" Background="#211B2B" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="TmdbStatus" Foreground="#A78BFA" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
<Border Background="#17131F" BorderBrush="#332A40" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Watchmode" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Opcional. A cobertura depende do plano e dos países ativados na conta. O app verifica cada consulta para o Brasil antes de exibir resultados. O plano Developer é para uso não comercial, com atribuição, e inclui até três países." Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,8,0,12"/><PasswordBox x:Name="WatchmodeKey" Background="#211B2B" Foreground="#F5F3FF" BorderBrush="#332A40" Padding="10"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Salvar chave" Click="SaveWatchmode_Click"/><Button Content="Testar conexão" Click="TestWatchmode_Click" Background="#211B2B" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="WatchmodeStatus" Foreground="#A78BFA" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
<Border Background="#17131F" BorderBrush="#332A40" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="Armazenamento local" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Crie um backup do banco SQLite ou restaure um arquivo SeuManga. As chaves protegidas de TMDB e Watchmode não fazem parte do backup." Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,8,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Criar backup" Click="CreateBackup_Click"/><Button Content="Restaurar backup" Click="RestoreBackup_Click" Background="#211B2B" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="BackupStatus" Foreground="#A78BFA" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel></ScrollViewer></Window>
