<Window x:Class="SeuManga.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações · SeuManga" Width="1000" Height="720" MinWidth="760" MinHeight="540"
        Background="#0D0B12" Foreground="#F5F3FF" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#211B2B"/>
            <Setter Property="Foreground" Value="#F5F3FF"/>
            <Setter Property="BorderBrush" Value="#332A40"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="CONFIGURAÇÕES" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Personalize sua experiência" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,4"/>
            <TextBlock Text="Preferências e dados permanecem neste dispositivo." Foreground="#A1A1AA"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="PREFERÊNCIAS" Foreground="#777287" FontSize="10" FontWeight="Bold" Margin="12,0,0,8"/>
                <Button x:Name="AppearanceNav" Content="◉   Aparência" Style="{StaticResource SettingsNavButton}" Click="SettingsSection_Click" Tag="Appearance"/>
                <Button x:Name="ReadingNav" Content="▤   Leitura" Style="{StaticResource SettingsNavButton}" Click="SettingsSection_Click" Tag="Reading"/>
                <Button x:Name="LibraryNav" Content="▣   Biblioteca" Style="{StaticResource SettingsNavButton}" Click="SettingsSection_Click" Tag="Library"/>
                <Button x:Name="LanguageNav" Content="文   Idioma" Style="{StaticResource SettingsNavButton}" Click="SettingsSection_Click" Tag="Language"/>
                <TextBlock Text="SISTEMA" Foreground="#777287" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
                <Button x:Name="StorageNav" Content="▤   Armazenamento" Style="{StaticResource SettingsNavButton}" Click="SettingsSection_Click" Tag="Storage"/>
                <Button x:Name="SourcesNav" Content="◎   Fontes de dados" Style="{StaticResource SettingsNavButton}" Click="SettingsSection_Click" Tag="Sources"/>
                <Button x:Name="AboutNav" Content="ⓘ   Sobre o SeuManga" Style="{StaticResource SettingsNavButton}" Click="SettingsSection_Click" Tag="About"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#17131F" BorderBrush="#332A40" BorderThickness="1" CornerRadius="14" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="AppearanceSection">
                            <TextBlock Text="Aparência" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <Border BorderBrush="#332A40" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Tema escuro" FontWeight="SemiBold"/>
                                    <TextBlock Text="O SeuManga foi desenhado para o modo escuro, confortável em longas sessões."
                                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="As cores e o contraste seguem o tema noturno em todas as telas."
                                       Foreground="#8F8A9B" FontSize="12" TextWrapping="Wrap" Margin="0,15,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="ReadingSection" Visibility="Collapsed">
                            <TextBlock Text="Leitura" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="O leitor oferece leitura página a página e rolagem contínua, com direção, layout e ajuste de imagem configuráveis."
                                       Foreground="#A1A1AA" TextWrapping="Wrap" LineHeight="21"/>
                            <Border Background="#211B2B" CornerRadius="9" Padding="14" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Atalhos e controles" FontWeight="SemiBold"/>
                                    <TextBlock Text="Use os controles do leitor para alternar o modo, a direção, o layout e o tamanho das páginas. O progresso é salvo automaticamente."
                                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="LibrarySection" Visibility="Collapsed">
                            <TextBlock Text="Biblioteca" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="Sua biblioteca, listas e progresso de leitura são armazenados localmente neste computador."
                                       Foreground="#A1A1AA" TextWrapping="Wrap" LineHeight="21"/>
                            <Border Background="#211B2B" CornerRadius="9" Padding="14" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Privacidade local" FontWeight="SemiBold"/>
                                    <TextBlock Text="Os dados pessoais permanecem no banco local do SeuManga. As chaves de provedores ficam protegidas para sua conta do Windows."
                                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="LanguageSection" Visibility="Collapsed">
                            <TextBlock Text="Idioma" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="Idioma da interface" FontWeight="SemiBold"/>
                            <TextBlock Text="Português (Brasil)" Foreground="#C4B5FD" Margin="0,5,0,0"/>
                            <TextBlock Text="No catálogo MangaDex, selecione o idioma dos capítulos nos filtros ou nos detalhes de cada mangá."
                                       Foreground="#A1A1AA" TextWrapping="Wrap" LineHeight="21" Margin="0,14,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="StorageSection" Visibility="Collapsed">
                            <TextBlock Text="Armazenamento local" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Crie um backup do banco SQLite ou restaure um arquivo SeuManga. As chaves protegidas de TMDB e Watchmode não fazem parte do backup."
                                       Foreground="#A1A1AA" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Criar backup" Click="CreateBackup_Click"/>
                                <Button Content="Restaurar backup" Click="RestoreBackup_Click" Background="#211B2B" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="BackupStatus" Foreground="#A78BFA" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="SourcesSection" Visibility="Collapsed">
                            <TextBlock Text="Fontes de dados" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="As chaves são criptografadas com DPAPI para sua conta Windows e nunca ficam no código ou em texto simples."
                                       Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Border Background="#1B1927" BorderBrush="#332A40" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="TMDB" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Complementa informações de séries, temporadas, banners e disponibilidade regional. O uso requer atribuição ao TMDB e JustWatch."
                                               Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                    <PasswordBox x:Name="TmdbKey" Background="#211B2B" Foreground="#F5F3FF" BorderBrush="#332A40" Padding="10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Button Content="Salvar chave" Click="SaveTmdb_Click"/>
                                        <Button Content="Testar conexão" Click="TestTmdb_Click" Background="#29243A" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TmdbStatus" Foreground="#A78BFA" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1B1927" BorderBrush="#332A40" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Watchmode" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Opcional. A cobertura depende do plano e dos países ativados na conta. O app verifica cada consulta para o Brasil antes de exibir resultados. O plano Developer é para uso não comercial, com atribuição, e inclui até três países."
                                               Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                    <PasswordBox x:Name="WatchmodeKey" Background="#211B2B" Foreground="#F5F3FF" BorderBrush="#332A40" Padding="10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Button Content="Salvar chave" Click="SaveWatchmode_Click"/>
                                        <Button Content="Testar conexão" Click="TestWatchmode_Click" Background="#29243A" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="WatchmodeStatus" Foreground="#A78BFA" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                            <TextBlock Text="Sobre o SeuManga" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="SeuManga" FontSize="24" FontWeight="Bold"/>
                            <TextBlock x:Name="VersionText" Foreground="#C4B5FD" Margin="0,5,0,0"/>
                            <TextBlock Text="Biblioteca pessoal de mangás e animes para Windows."
                                       Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
