<Window x:Class="SeuManga.Desktop.Views.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Minha biblioteca · SeuManga" Width="1080" Height="760" MinWidth="760" MinHeight="520" Background="#0D0B12" Foreground="#F5F3FF" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#8B5CF6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,7"/><Setter Property="Cursor" Value="Hand"/></Style></Window.Resources>
<Grid Margin="30"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="COLEÇÃO LOCAL" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/><TextBlock Text="Minha biblioteca" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="Message" Text="Seus títulos ficam disponíveis offline neste dispositivo." Foreground="#A1A1AA" Margin="0,6,0,0"/></StackPanel>
<TabControl Background="#17131F" Foreground="#F5F3FF" BorderBrush="#332A40"><TabItem Header="Mangás"><ListView x:Name="Entries" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Border Background="#17131F" BorderBrush="#332A40" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="54" Height="70" Background="#211B2B" CornerRadius="6" ClipToBounds="True"><Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Foreground="#A78BFA" Margin="0,5,0,0"/><TextBlock Text="{Binding LastChapterNumber, StringFormat=Último capítulo: {0}}" Foreground="#A1A1AA" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Lendo" Tag="{Binding MangaDexId}" Click="Reading_Click" Background="#6D28D9"/><Button Content="Alternar favorito" Tag="{Binding MangaDexId}" Click="Favorite_Click" Background="#211B2B" Margin="7,0"/><Button Content="Remover" Tag="{Binding MangaDexId}" Click="Remove_Click" Background="#211B2B"/></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></TabItem>
<TabItem Header="Animes"><ListView x:Name="AnimeEntries" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Border Background="#17131F" BorderBrush="#332A40" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="54" Height="70" Background="#211B2B" CornerRadius="6" ClipToBounds="True"><Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ProgressText}" Foreground="#A78BFA" Margin="0,6,0,0"/><TextBlock Text="{Binding StatusLabel}" Foreground="#A1A1AA" FontSize="11" Margin="0,4,0,0"/><ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5" Background="#332A40" Foreground="#8B5CF6" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center"><Button Content="{Binding FavoriteLabel}" Tag="{Binding JikanId}" Click="AnimeFavorite_Click" Background="#211B2B" Margin="0,0,0,4"/><Button Content="Planejo" Tag="{Binding JikanId}" CommandParameter="PlanToWatch" Click="AnimeStatus_Click" Background="#211B2B" Margin="0,0,0,4"/><Button Content="Assistindo" Tag="{Binding JikanId}" CommandParameter="Watching" Click="AnimeStatus_Click" Background="#211B2B" Margin="0,0,0,4"/><Button Content="Concluído" Tag="{Binding JikanId}" CommandParameter="Completed" Click="AnimeStatus_Click" Background="#211B2B" Margin="0,0,0,4"/><Button Content="Pausado" Tag="{Binding JikanId}" CommandParameter="OnHold" Click="AnimeStatus_Click" Background="#211B2B" Margin="0,0,0,4"/><Button Content="Abandonado" Tag="{Binding JikanId}" CommandParameter="Dropped" Click="AnimeStatus_Click" Background="#211B2B" Margin="0,0,0,4"/><Button Content="Remover" Tag="{Binding JikanId}" Click="AnimeRemove_Click" Background="#211B2B"/></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></TabItem></TabControl>
</DockPanel></Grid></Window>


