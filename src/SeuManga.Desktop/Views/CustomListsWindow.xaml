<Window x:Class="SeuManga.Desktop.Views.CustomListsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Listas personalizadas · SeuManga" Width="980" Height="700" MinWidth="700" MinHeight="500" Background="#0D0B12" Foreground="#F5F3FF" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#8B5CF6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,8"/><Setter Property="Cursor" Value="Hand"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#211B2B"/><Setter Property="Foreground" Value="#F5F3FF"/><Setter Property="BorderBrush" Value="#332A40"/><Setter Property="Padding" Value="10,8"/></Style></Window.Resources>
<DockPanel Margin="28"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="ORGANIZAÇÃO PESSOAL" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/><TextBlock Text="Minhas listas" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,14"/><DockPanel><Button DockPanel.Dock="Right" Content="Criar lista" Click="Create_Click" Margin="10,0,0,0"/><TextBox x:Name="NewListName" ToolTip="Nome da lista"/></DockPanel><TextBlock x:Name="Message" Foreground="#A1A1AA" Margin="0,8,0,0"/></StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><ListBox x:Name="Lists" SelectionChanged="Lists_SelectionChanged" SelectedValuePath="Id" Background="#17131F" BorderBrush="#332A40" Foreground="#F5F3FF" DisplayMemberPath="Name" Margin="0,0,16,0"/><DockPanel Grid.Column="1"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><ComboBox x:Name="LibraryChoices" MinWidth="220" DisplayMemberPath="DisplayLabel" Background="#211B2B" Foreground="#F5F3FF"/><Button Content="Adicionar item" Click="Add_Click" Margin="8,0,0,0"/></StackPanel><DockPanel><Button DockPanel.Dock="Bottom" Content="Remover item selecionado" Click="Remove_Click" Background="#211B2B" Margin="0,10,0,0" HorizontalAlignment="Left"/><ListBox x:Name="ListItems" Background="#17131F" BorderBrush="#332A40" Foreground="#F5F3FF"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4"><TextBlock Text="{Binding ContentKind}" Foreground="#A78BFA" Margin="0,0,8,0"/><TextBlock Text="{Binding Title}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></DockPanel></Grid></DockPanel></Window>


