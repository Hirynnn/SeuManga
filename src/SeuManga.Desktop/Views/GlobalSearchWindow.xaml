<Window x:Class="SeuManga.Desktop.Views.GlobalSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pesquisa global · SeuManga" Width="1000" Height="720" MinWidth="750" MinHeight="500" Background="#0D0B12" Foreground="#F5F3FF" WindowStartupLocation="CenterOwner">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#8B5CF6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#211B2B"/><Setter Property="Foreground" Value="#F5F3FF"/><Setter Property="BorderBrush" Value="#332A40"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="White"/></Style></Window.Resources>
<DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="PESQUISA GLOBAL" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/><TextBlock Text="Encontre sua próxima história" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,16"/><DockPanel><Button DockPanel.Dock="Right" Content="Pesquisar" Command="{Binding SearchCommand}" Margin="10,0,0,0"/><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown"/></DockPanel><StackPanel Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSuggestions}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Pesquisas recentes" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,4"/><ItemsControl ItemsSource="{Binding Suggestions}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Tag="{Binding}" Click="Suggestion_Click" HorizontalAlignment="Left" Background="Transparent" Foreground="#A78BFA" Padding="4,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><TextBlock Text="{Binding Message}" Foreground="#A1A1AA" Margin="0,10,0,14"/></StackPanel>
<TabControl Background="#17131F" Foreground="#F5F3FF" BorderBrush="#332A40"><TabItem Header="Mangás"><ListView x:Name="MangaResults" ItemsSource="{Binding Mangas}" MouseDoubleClick="Manga_DoubleClick" Background="#17131F" BorderBrush="#332A40" Foreground="#F5F3FF"><ListView.ItemTemplate><DataTemplate><Border Padding="12" BorderBrush="#332A40" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#A78BFA" Margin="0,5,0,0"/><TextBlock Text="{Binding Description}" Foreground="#A1A1AA" TextWrapping="Wrap" MaxHeight="44" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></TabItem>
<TabItem Header="Animes"><ListView x:Name="AnimeResults" ItemsSource="{Binding Animes}" MouseDoubleClick="Anime_DoubleClick" Background="#17131F" BorderBrush="#332A40" Foreground="#F5F3FF"><ListView.ItemTemplate><DataTemplate><Border Padding="12" BorderBrush="#332A40" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding TitleEnglish}" Foreground="#A78BFA" Margin="0,5,0,0"/><TextBlock Text="{Binding Synopsis}" Foreground="#A1A1AA" TextWrapping="Wrap" MaxHeight="44" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></TabItem></TabControl>
</DockPanel></Window>
