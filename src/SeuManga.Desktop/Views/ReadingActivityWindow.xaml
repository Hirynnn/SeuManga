<Window x:Class="SeuManga.Desktop.Views.ReadingActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SeuManga.Desktop.Controls"
        Title="Atividade · SeuManga" Width="1000" Height="700" MinWidth="700" MinHeight="500"
        Background="#0D0B12" Foreground="#F5F3FF" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="SUA ATIVIDADE" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="Heading" Text="Histórico" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,3"/>
            <TextBlock x:Name="Summary" Text="" Foreground="#A1A1AA"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid x:Name="HistoryView">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoryItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Rectangle Width="1" Fill="#38334D" HorizontalAlignment="Center"/>
                                        <Ellipse Width="8" Height="8" Fill="#8B5CF6" Stroke="#0D0B12" StrokeThickness="2"
                                                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,19,0,0"/>
                                    </Grid>
                                    <Border Grid.Column="1" Background="#17131F" BorderBrush="#332A40" BorderThickness="1"
                                            CornerRadius="12" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="48" Height="62" Background="#211B2B" CornerRadius="6" ClipToBounds="True">
                                                <controls:MangaDexCoverImage CoverUrl="{Binding Entry.CoverUrl}"
                                                    ImageProvider="{Binding ImageProvider, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ChapterLabel}" Foreground="#A1A1AA" FontSize="11" Margin="0,4,0,0"/>
                                                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Width="190"
                                                             HorizontalAlignment="Left" Background="#332A40" Foreground="#8B5CF6"
                                                             Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ProgressLabel}" Foreground="#C4B5FD" FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding UpdatedLabel}" Foreground="#858092" FontSize="10"
                                                           HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="FavoritesView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FavoriteItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,16">
                                    <Border Height="250" Background="#211B2B" BorderBrush="#332A40" BorderThickness="1"
                                            CornerRadius="12" ClipToBounds="True">
                                        <controls:MangaDexCoverImage CoverUrl="{Binding CoverUrl}"
                                            ImageProvider="{Binding ImageProvider, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Margin="0,8,0,3" MaxHeight="38"/>
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="#A1A1AA" FontSize="11"/>
                                    <Border Background="#1B1927" BorderBrush="#38334D" BorderThickness="1"
                                            CornerRadius="10" Padding="7,3" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock Text="Favorito" Foreground="#C4B5FD" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <TextBlock x:Name="EmptyMessage" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="#858092" Margin="24" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
