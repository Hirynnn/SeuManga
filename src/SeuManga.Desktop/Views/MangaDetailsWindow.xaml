<Window x:Class="SeuManga.Desktop.Views.MangaDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SeuManga.Desktop.Controls" Title="Detalhes do mangá" Width="1040" Height="780" MinWidth="760" MinHeight="560" Background="#0D0B12" Foreground="#F5F3FF" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#1B1927"/>
            <Setter Property="Foreground" Value="#F5F3FF"/>
            <Setter Property="BorderBrush" Value="#38334D"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F5F3FF"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#17131F" BorderBrush="#2D293C" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DETALHES DO MANGÁ" Foreground="#A78BFA" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Manga.Title}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ChapterMessage" Text="{Binding Message}" Foreground="#A1A1AA" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="＋  Adicionar à biblioteca" Click="AddToLibrary_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                <StackPanel>
                    <Border Height="360" Background="#211B2B" BorderBrush="#2D293C" BorderThickness="1" CornerRadius="14" ClipToBounds="True"><controls:MangaDexCoverImage CoverUrl="{Binding Manga.CoverUrl}" ImageProvider="{Binding ImageProvider}" Stretch="UniformToFill"/></Border>
                    <Border Background="#17131F" BorderBrush="#2D293C" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Manga.Status}" Foreground="#C4B5FD" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Manga.Description}" Foreground="#C4C1D0" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
                            <TextBlock Text="{Binding Manga.OriginalLanguage, StringFormat=Idioma original: {0}}" Foreground="#A1A1AA" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Background="#17131F" BorderBrush="#2D293C" BorderThickness="1" CornerRadius="14" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{Binding ChapterListHeading}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Escolha uma tradução para ver os capítulos disponíveis." Foreground="#A1A1AA" FontSize="12" Margin="0,4,0,10"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" IsEnabled="{Binding CanChooseLanguage}" AutomationProperties.Name="Idioma dos capítulos"/>
                        <Button Content="Carregar mais capítulos" Command="{Binding LoadMoreCommand}" Background="#29243A" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="ChapterList" ItemsSource="{Binding Chapters}" SelectionChanged="ChapterList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C1928" BorderBrush="#302B40" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Chapter, StringFormat=Capítulo {0}}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Title}" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Group}" Foreground="#8B82A5" FontSize="11" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="›" Foreground="#A78BFA" FontSize="22" VerticalAlignment="Center" Margin="12,0,2,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
