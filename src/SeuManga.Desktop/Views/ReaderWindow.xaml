<Window x:Class="SeuManga.Desktop.Views.ReaderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Leitor · SeuManga" Width="1180" Height="850" MinWidth="640" MinHeight="480" Background="#0D0B12" Foreground="#F5F3FF" KeyDown="Window_KeyDown" WindowStartupLocation="CenterOwner">
    <DockPanel><Border DockPanel.Dock="Top" Background="#17131F" BorderBrush="#332A40" BorderThickness="0,0,0,1" Padding="12"><DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="PreviousChapterButton" Content="Capítulo anterior" Click="PreviousChapter_Click" Background="#211B2B"/><Button x:Name="NextChapterButton" Content="Próximo capítulo" Click="NextChapter_Click" Background="#211B2B" Margin="8,0,8,0"/><Button x:Name="PreviousButton" Content="‹ Página" Click="Previous_Click" Background="#211B2B"/><Button x:Name="NextButton" Content="Página ›" Click="Next_Click" Background="#211B2B" Margin="8,0,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="12,0"/><ComboBox x:Name="PageSelector" Width="84" SelectionChanged="PageSelector_SelectionChanged" Background="#211B2B" Foreground="#F5F3FF" BorderBrush="#332A40" Margin="0,0,8,0"/><ComboBox x:Name="ReadingDirection" Width="180" SelectedIndex="0" SelectionChanged="ReadingDirection_SelectionChanged" Background="#211B2B" Foreground="#F5F3FF" BorderBrush="#332A40" Margin="0,0,8,0"><ComboBoxItem Content="Mangá · direita para esquerda"/><ComboBoxItem Content="Ocidental · esquerda para direita"/></ComboBox><ComboBox x:Name="PageLayout" Width="120" SelectedIndex="0" SelectionChanged="PageLayout_SelectionChanged" Background="#211B2B" Foreground="#F5F3FF" BorderBrush="#332A40" Margin="0,0,8,0"><ComboBoxItem Content="Página individual"/><ComboBoxItem Content="Duas páginas"/></ComboBox><ComboBox x:Name="ImageFit" Width="125" SelectedIndex="0" SelectionChanged="ImageFit_SelectionChanged" Background="#211B2B" Foreground="#F5F3FF" BorderBrush="#332A40" Margin="0,0,8,0"><ComboBoxItem Content="Ajustar largura"/><ComboBoxItem Content="Ajustar altura"/><ComboBoxItem Content="Conter na tela"/><ComboBoxItem Content="Tamanho original"/></ComboBox><Button Content="−" Click="ZoomOut_Click" Background="#211B2B" Padding="10,8"/><Button Content="+" Click="ZoomIn_Click" Background="#211B2B" Padding="10,8" Margin="4,0,8,0"/><Button Content="Tela cheia" Click="Fullscreen_Click" Background="#211B2B"/></StackPanel>
        <TextBlock x:Name="ChapterTitle" Text="Leitor MangaDex" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DockPanel></Border><wv2:WebView2 x:Name="Reader" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"/></DockPanel>
</Window>

