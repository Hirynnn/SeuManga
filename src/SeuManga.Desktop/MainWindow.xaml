<Window x:Class="SeuManga.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SeuManga.Desktop.Controls"
        Title="SeuManga" Height="760" Width="1280" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#0D0B12" Foreground="#F5F3FF" FontFamily="Segoe UI" KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/><Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#211B2B"/><Setter Property="Foreground" Value="#F5F3FF"/>
            <Setter Property="BorderBrush" Value="#332A40"/><Setter Property="CaretBrush" Value="#A78BFA"/>
            <Setter Property="Padding" Value="12,9"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="14,11"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Margin="8,0,0,0"/>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#211B2B"/><Setter Property="Foreground" Value="#F5F3FF"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#6D5A91"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#12111A" BorderBrush="#282535" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,4,0,30">
                        <Border Width="38" Height="38" CornerRadius="12">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A78BFA" Offset="0"/><GradientStop Color="#6D28D9" Offset="1"/></LinearGradientBrush></Border.Background>
                            <TextBlock Text="S" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SeuManga" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="MANGÁS · ANIMES" FontSize="9" Foreground="#8B82A5" FontWeight="Bold" Margin="1,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="DESCOBRIR" FontSize="10" FontWeight="Bold" Foreground="#777287" Margin="12,0,0,8"/>
                    <Button x:Name="HomeNavButton" AutomationProperties.AutomationId="HomeNavigation" Style="{StaticResource NavButton}" Content="⌂    Início" Click="Home_Click"/>
                    <Button x:Name="MangaNavButton" AutomationProperties.AutomationId="MangaNavigation" Style="{StaticResource NavButton}" Content="⌕    Explorar mangás" Click="Manga_Click"/>
                    <Button x:Name="AnimeNavButton" AutomationProperties.AutomationId="AnimeNavigation" Style="{StaticResource NavButton}" Content="◈    Explorar animes" Click="Anime_Click"/>
                    <TextBlock Text="SUA BIBLIOTECA" FontSize="10" FontWeight="Bold" Foreground="#777287" Margin="12,22,0,8"/>
                    <Button x:Name="LibraryNavButton" AutomationProperties.AutomationId="LibraryNavigation" Style="{StaticResource NavButton}" Content="▤    Minha biblioteca" Click="Library_Click"/>
                    <Button x:Name="HistoryNavButton" AutomationProperties.AutomationId="HistoryNavigation" Style="{StaticResource NavButton}" Content="◷    Histórico" Click="History_Click"/>
                    <Button x:Name="FavoritesNavButton" AutomationProperties.AutomationId="FavoritesNavigation" Style="{StaticResource NavButton}" Content="♡    Favoritos" Click="Favorites_Click"/>
                    <Button x:Name="ListsNavButton" AutomationProperties.AutomationId="ListsNavigation" Style="{StaticResource NavButton}" Content="▧    Listas personalizadas" Click="Lists_Click"/>
                    <TextBlock Text="PREFERÊNCIAS" FontSize="10" FontWeight="Bold" Foreground="#777287" Margin="12,22,0,8"/>
                    <Button x:Name="SettingsNavButton" AutomationProperties.AutomationId="SettingsNavigation" Style="{StaticResource NavButton}" Content="⚙    Configurações" Click="Settings_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#191722" BorderBrush="#282535" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="2,0,2,3">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center"/><TextBlock Text="  Biblioteca neste dispositivo" Foreground="#A1A1AA" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="HomeView" Grid.Column="1" VerticalScrollBarVisibility="Auto" Loaded="Home_Loaded">
            <StackPanel Margin="42,28,42,48" MaxWidth="1120" HorizontalAlignment="Stretch">
                <DockPanel Margin="0,0,0,24">
                    <Button DockPanel.Dock="Right" Content="Buscar tudo" Click="GlobalSearch_Click" Margin="10,0,0,0" Padding="18,11"/>
                    <TextBox x:Name="GlobalQuery" ToolTip="Buscar mangás e animes" KeyDown="GlobalQuery_KeyDown"
                             Padding="14,11" AutomationProperties.Name="Buscar mangás e animes"/>
                </DockPanel>

                <Border Height="300" CornerRadius="20" BorderBrush="#40334F" BorderThickness="1" ClipToBounds="True"
                        Background="#191522">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFeaturedReading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <controls:MangaDexCoverImage CoverUrl="{Binding FeaturedReading.CoverUrl}" ImageProvider="{Binding ImageProvider}"
                                                     Stretch="UniformToFill" Opacity="0.35"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F00D0B12" Offset="0"/>
                                    <GradientStop Color="#E60D0B12" Offset="0.48"/>
                                    <GradientStop Color="#3017121F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="32" MaxWidth="620">
                            <TextBlock Text="CONTINUE SUA JORNADA" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding FeaturedReading.Title}" FontSize="32" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding FeaturedReading.ChapterNumber, StringFormat=Capítulo {0}}"
                                       Foreground="#D4D4D8" FontSize="15"/>
                            <TextBlock Text="{Binding FeaturedPageLabel}"
                                       Foreground="#A1A1AA" FontSize="12" Margin="0,4,0,18"/>
                            <Button Content="▶  Continuar lendo" Tag="{Binding FeaturedReading}" Click="ResumeReading_Click"
                                    HorizontalAlignment="Left" Padding="19,11"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#B3211B2B"
                                CornerRadius="10" Padding="11,7" Margin="16">
                            <TextBlock Text="✦  EM LEITURA" Foreground="#DDD6FE" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Height="240" CornerRadius="20" BorderBrush="#40334F" BorderThickness="1" Padding="30"
                        Background="#191522">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFeaturedReading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SEU ESPAÇO PARA MANGÁS E ANIMES" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Sua próxima história começa aqui." FontSize="30" FontWeight="SemiBold" Margin="0,12,0,8"/>
                        <TextBlock Text="Descubra novos títulos ou explore sua biblioteca." Foreground="#A1A1AA" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Explorar mangás" Click="Manga_Click"/>
                            <Button Content="Explorar animes" Click="Anime_Click" Margin="10,0,0,0" Background="#29243A"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding HomeMessage}" Foreground="#8F8A9B" FontSize="11" Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

                <DockPanel Margin="0,30,0,12">
                    <Button DockPanel.Dock="Right" Content="Ver catálogo  ›" Click="Manga_Click" Background="Transparent"
                            Foreground="#C4B5FD" Padding="8,4"/>
                    <StackPanel>
                        <TextBlock Text="CONTINUE LENDO" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Volte para suas histórias" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding RecentReads}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="ResumeReading_Click" Background="#17131F" BorderBrush="#332A40"
                                    BorderThickness="1" Padding="10" Margin="0,0,10,10" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="62" Height="86" Background="#211B2B" CornerRadius="7" ClipToBounds="True">
                                        <controls:MangaDexCoverImage CoverUrl="{Binding CoverUrl}"
                                            ImageProvider="{Binding DataContext.ImageProvider, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ChapterNumber, StringFormat=Capítulo {0}}"
                                                   Foreground="#C4B5FD" FontSize="12" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}"
                                                   Foreground="#858092" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,28,0,12">
                    <Button DockPanel.Dock="Right" Content="Ver animes  ›" Click="Anime_Click" Background="Transparent"
                            Foreground="#C4B5FD" Padding="8,4"/>
                    <StackPanel>
                        <TextBlock Text="CONTINUE ASSISTINDO" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Sua lista de animes" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding TrackedAnime}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="ContinueAnime_Click" Background="#17131F" BorderBrush="#332A40"
                                    BorderThickness="1" Padding="12" Margin="0,0,10,10" HorizontalContentAlignment="Stretch">
                                <StackPanel>
                                    <Grid Height="126" ClipToBounds="True">
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                        <Border VerticalAlignment="Bottom" Height="48">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#0017131F" Offset="0"/>
                                                    <GradientStop Color="#E617131F" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Bottom" Margin="10,0,10,9"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Margin="0,12,0,7"
                                                 Background="#332A40" Foreground="#8B5CF6"/>
                                    <TextBlock Text="{Binding ProgressText}" Foreground="#C4B5FD" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,28,0,12">
                    <Button DockPanel.Dock="Right" Content="Explorar  ›" Click="Anime_Click" Background="Transparent"
                            Foreground="#C4B5FD" Padding="8,4"/>
                    <StackPanel>
                        <TextBlock Text="POPULAR AGORA · JIKAN" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Histórias em alta" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PopularAnime}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="PopularAnime_Click" Background="#17131F" BorderBrush="#332A40"
                                        BorderThickness="1" Width="174" Padding="9" Margin="0,0,10,0" HorizontalContentAlignment="Left">
                                    <StackPanel>
                                        <Border Height="190" Background="#211B2B" CornerRadius="8" ClipToBounds="True">
                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Foreground="#F5F3FF" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,9,0,0" MaxHeight="40"/>
                                        <TextBlock Text="{Binding Score, StringFormat=★  {0}}"
                                                   Foreground="#C4B5FD" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <DockPanel Margin="0,28,0,12">
                    <TextBlock Text="FEITO PARA VOCÊ" Foreground="#A78BFA" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding HomeRecommendations}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Anime}" Click="RecommendedAnime_Click" Background="#17131F"
                                    BorderBrush="#332A40" BorderThickness="1" Padding="12" Margin="0,0,10,10"
                                    HorizontalContentAlignment="Left">
                                <DockPanel>
                                    <Border Width="46" Height="60" Background="#211B2B" CornerRadius="5" ClipToBounds="True">
                                        <Image Source="{Binding Anime.ImageUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Anime.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Votes, StringFormat=Recomendado por {0} votos}"
                                                   Foreground="#8F8A9B" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="PageContainer" Grid.Column="1" Visibility="Collapsed" Background="#0D0B12">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#17131F" BorderBrush="#332A40" BorderThickness="0,0,0,1" Padding="26,16">
                    <DockPanel>
                        <Button x:Name="BackButton" AutomationProperties.AutomationId="BackNavigation" DockPanel.Dock="Left" Content="‹   Voltar" Click="Back_Click" Background="#211B2B" Padding="14,9" Margin="0,0,16,0"/>
                        <TextBlock x:Name="PageHeading" AutomationProperties.AutomationId="PageHeading" Text="SeuManga" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="SEUMANGA" Foreground="#A78BFA" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="PageHost" Background="#0D0B12"/>
            </DockPanel>
        </Border>
        <Border Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <wv2:WebView2 x:Name="MangaDexNetworkBrowser"
                          xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                          IsHitTestVisible="False" Focusable="False"/>
        </Border>
    </Grid>
</Window>
